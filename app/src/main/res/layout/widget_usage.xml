<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Today's data"
        android:textColor="#B4BCC9"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_total"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0.0 MB"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_detail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#B4BCC9"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_limit_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#8EA5FF"
        android:textSize="12sp"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/widget_limit_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="4dp"
        android:max="100"
        android:progressTint="#8EA5FF"
        android:progressBackgroundTint="#33FFFFFF"
        android:visibility="gone" />
</LinearLayout>
